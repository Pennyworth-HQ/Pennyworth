<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Pennyworth.App.ViewModels"
             xmlns:views="using:Pennyworth.App.Views"
             x:Class="Pennyworth.App.App"
             RequestedThemeVariant="Default">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://Pennyworth/Theme/Tokens.axaml" />
        <ResourceInclude Source="avares://Pennyworth/Theme/WindowDecorations.axaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Application.Resources>

  <Application.Styles>
    <SimpleTheme />
    <StyleInclude Source="avares://Pennyworth/Theme/Styles.axaml" />
  </Application.Styles>

  <!-- One view per page; dialogs are templated in MainWindow. -->
  <Application.DataTemplates>
    <DataTemplate DataType="vm:WelcomeViewModel">
      <views:WelcomeView />
    </DataTemplate>
    <DataTemplate DataType="vm:HomeViewModel">
      <views:HomeView />
    </DataTemplate>
    <DataTemplate DataType="vm:StorageSummaryViewModel">
      <views:StorageSummaryView />
    </DataTemplate>
    <DataTemplate DataType="vm:CleanupViewModel">
      <views:CleanupView />
    </DataTemplate>
    <DataTemplate DataType="vm:MemoryViewModel">
      <views:MemoryView />
    </DataTemplate>
    <DataTemplate DataType="vm:FolderBrowserViewModel">
      <views:FolderBrowserView />
    </DataTemplate>
    <DataTemplate DataType="vm:PcViewModel">
      <views:PcView />
    </DataTemplate>
  </Application.DataTemplates>
</Application>
