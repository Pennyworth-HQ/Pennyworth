<!--
  Design tokens, taken from the Claude Design mockup (docs/design/Pennyworth.dc.html).
  Views and controls only reference these keys, never raw colours or sizes.

  The design is monochrome: categories are told apart by the pattern drawn in each
  bar segment (see Controls/SegmentedBar.cs), never by colour alone. The selected
  category is drawn in Brush.Accent.
-->
<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ResourceDictionary.ThemeDictionaries>
    <ResourceDictionary x:Key="Light">
      <SolidColorBrush x:Key="Brush.Background" Color="#F1EFEA" />
      <SolidColorBrush x:Key="Brush.Surface" Color="#F8F7F3" />
      <SolidColorBrush x:Key="Brush.SurfaceHover" Color="#E7E4DE" />
      <SolidColorBrush x:Key="Brush.Border" Color="#D6D2CA" />
      <SolidColorBrush x:Key="Brush.BorderStrong" Color="#B7B2A8" />
      <SolidColorBrush x:Key="Brush.Track" Color="#E2DFD8" />
      <SolidColorBrush x:Key="Brush.TextPrimary" Color="#161614" />
      <SolidColorBrush x:Key="Brush.TextSecondary" Color="#57544E" />
      <SolidColorBrush x:Key="Brush.TextTertiary" Color="#9A968E" />
      <SolidColorBrush x:Key="Brush.Accent" Color="#B53700" />
      <SolidColorBrush x:Key="Brush.AccentHover" Color="#9D2800" />
      <SolidColorBrush x:Key="Brush.OnAccent" Color="#FFFFFF" />
      <SolidColorBrush x:Key="Brush.Warning" Color="#B53700" />
      <SolidColorBrush x:Key="Brush.Scrim" Color="#B8DCD9D2" />

      <SolidColorBrush x:Key="Brush.Category.Games" Color="#161614" />
      <SolidColorBrush x:Key="Brush.Category.Apps" Color="#161614" />
      <SolidColorBrush x:Key="Brush.Category.YourFiles" Color="#161614" />
      <SolidColorBrush x:Key="Brush.Category.Windows" Color="#161614" />
      <SolidColorBrush x:Key="Brush.Category.HiddenSystem" Color="#161614" />
      <SolidColorBrush x:Key="Brush.Category.Other" Color="#161614" />
      <SolidColorBrush x:Key="Brush.Category.Unaccounted" Color="#57544E" />
    </ResourceDictionary>
    <ResourceDictionary x:Key="Dark">
      <SolidColorBrush x:Key="Brush.Background" Color="#0E0E0D" />
      <SolidColorBrush x:Key="Brush.Surface" Color="#151513" />
      <SolidColorBrush x:Key="Brush.SurfaceHover" Color="#1C1C1A" />
      <SolidColorBrush x:Key="Brush.Border" Color="#262522" />
      <SolidColorBrush x:Key="Brush.BorderStrong" Color="#3A3935" />
      <SolidColorBrush x:Key="Brush.Track" Color="#1D1C1A" />
      <SolidColorBrush x:Key="Brush.TextPrimary" Color="#EBE8E1" />
      <SolidColorBrush x:Key="Brush.TextSecondary" Color="#A39F96" />
      <SolidColorBrush x:Key="Brush.TextTertiary" Color="#5F5C56" />
      <SolidColorBrush x:Key="Brush.Accent" Color="#F57E4D" />
      <SolidColorBrush x:Key="Brush.AccentHover" Color="#FF9661" />
      <SolidColorBrush x:Key="Brush.OnAccent" Color="#0E0E0D" />
      <SolidColorBrush x:Key="Brush.Warning" Color="#F57E4D" />
      <SolidColorBrush x:Key="Brush.Scrim" Color="#BD050504" />

      <SolidColorBrush x:Key="Brush.Category.Games" Color="#EBE8E1" />
      <SolidColorBrush x:Key="Brush.Category.Apps" Color="#EBE8E1" />
      <SolidColorBrush x:Key="Brush.Category.YourFiles" Color="#EBE8E1" />
      <SolidColorBrush x:Key="Brush.Category.Windows" Color="#EBE8E1" />
      <SolidColorBrush x:Key="Brush.Category.HiddenSystem" Color="#EBE8E1" />
      <SolidColorBrush x:Key="Brush.Category.Other" Color="#EBE8E1" />
      <SolidColorBrush x:Key="Brush.Category.Unaccounted" Color="#A39F96" />
    </ResourceDictionary>
  </ResourceDictionary.ThemeDictionaries>

  <!-- The design's fonts, bundled in Assets/Fonts (SIL OFL 1.1). Windows fonts cover missing glyphs. -->
  <FontFamily x:Key="FontFamily.Base">avares://Pennyworth/Assets/Fonts#Golos Text, Segoe UI</FontFamily>
  <FontFamily x:Key="FontFamily.Mono">avares://Pennyworth/Assets/Fonts#JetBrains Mono, Consolas</FontFamily>

  <x:Double x:Key="FontSize.Title">34</x:Double>
  <x:Double x:Key="FontSize.Heading">17</x:Double>
  <x:Double x:Key="FontSize.Body">14</x:Double>
  <x:Double x:Key="FontSize.Caption">12</x:Double>
  <!-- Monospace, upper-case section labels ("02 / STORAGE"). -->
  <x:Double x:Key="FontSize.Label">10.5</x:Double>
  <x:Double x:Key="LetterSpacing.Title">-0.7</x:Double>
  <x:Double x:Key="LetterSpacing.Label">1.4</x:Double>

  <!-- The design uses square corners throughout. -->
  <CornerRadius x:Key="Radius.Card">0</CornerRadius>
  <CornerRadius x:Key="Radius.Control">0</CornerRadius>

  <Thickness x:Key="Padding.Page">36,28,36,24</Thickness>
  <Thickness x:Key="Padding.Card">20,18</Thickness>
  <Thickness x:Key="Padding.Row">10</Thickness>
  <Thickness x:Key="Padding.Button">14,0</Thickness>

  <x:Double x:Key="Height.TitleBar">44</x:Double>
  <x:Double x:Key="Height.StatusBar">28</x:Double>
  <x:Double x:Key="Height.Button">34</x:Double>
  <x:Double x:Key="Height.Row">44</x:Double>
  <x:Double x:Key="Height.StorageBar">76</x:Double>
  <x:Double x:Key="Width.Sidebar">216</x:Double>

  <BoxShadows x:Key="Shadow.Dialog">0 30 60 -20 #80000000</BoxShadows>
</ResourceDictionary>
