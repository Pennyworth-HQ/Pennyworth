<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Pennyworth.App.ViewModels"
             xmlns:l="using:Pennyworth.App.Localization"
             xmlns:controls="using:Pennyworth.App.Controls"
             x:Class="Pennyworth.App.Views.HistoryView"
             x:DataType="vm:HistoryViewModel">
  <UserControl.Styles>
    <!-- Errors and critical events stand out from warnings. -->
    <Style Selector="Border.badge.accent">
      <Setter Property="BorderBrush" Value="{DynamicResource Brush.Accent}" />
    </Style>
    <Style Selector="Border.badge.accent > TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource Brush.Accent}" />
    </Style>
  </UserControl.Styles>

  <ScrollViewer HorizontalScrollBarVisibility="Disabled">
    <StackPanel Margin="36,28,36,28" Spacing="20">
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
        <StackPanel Spacing="8">
          <TextBlock Classes="label">
            <Run Text="08 / " />
            <Run Text="{l:Tr NavHistory, Upper=True}" />
          </TextBlock>
          <TextBlock Classes="title" Text="{l:Tr HistoryTitle}" />
          <TextBlock Classes="secondary" FontSize="13" TextWrapping="Wrap" MaxWidth="720" HorizontalAlignment="Left" Text="{l:Tr HistorySub}" />
        </StackPanel>
        <Border Grid.Column="1" Classes="group" VerticalAlignment="Bottom">
          <StackPanel Orientation="Horizontal">
            <Button Classes="segment" Classes.selected="{Binding IsDay}" Content="{l:Tr Range24h, Upper=True}" Command="{Binding ShowDayCommand}" />
            <Border Width="1" Background="{DynamicResource Brush.BorderStrong}" />
            <Button Classes="segment" Classes.selected="{Binding IsWeek}" Content="{l:Tr Range7d, Upper=True}" Command="{Binding ShowWeekCommand}" />
          </StackPanel>
        </Border>
      </Grid>

      <TextBlock FontSize="14" TextWrapping="Wrap" Text="{Binding CoverageText}" />

      <!-- One card per metric, two per row. -->
      <ItemsControl ItemsSource="{Binding Charts}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <UniformGrid Columns="2" />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:MetricChartViewModel">
            <Border Margin="0,0,-1,-1" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" Padding="20,18">
              <StackPanel Spacing="10">
                <Grid ColumnDefinitions="*,Auto">
                  <TextBlock Classes="label" FontSize="10" Text="{Binding Title, Converter={x:Static controls:TextCase.Upper}}" />
                  <TextBlock Grid.Column="1" Classes="mono tertiary" FontSize="9.5" Text="{Binding ThresholdText}" />
                </Grid>
                <TextBlock Classes="mono" FontSize="12" TextTrimming="CharacterEllipsis" Text="{Binding SummaryText}" />
                <controls:TimelineChart Height="96" Peaks="{Binding Peaks}" Averages="{Binding Averages}" Labels="{Binding Labels}" Threshold="{Binding Threshold}"
                                        BarBrush="{DynamicResource Brush.BorderStrong}" HotBrush="{DynamicResource Brush.Accent}"
                                        LineBrush="{DynamicResource Brush.TextPrimary}" GridBrush="{DynamicResource Brush.Border}"
                                        TextBrush="{DynamicResource Brush.TextPrimary}" />
                <Grid ColumnDefinitions="*,*,*">
                  <TextBlock Classes="mono tertiary" FontSize="9.5" Text="{Binding StartLabel}" />
                  <TextBlock Grid.Column="1" Classes="mono tertiary" FontSize="9.5" HorizontalAlignment="Center" Text="{Binding MiddleLabel}" />
                  <TextBlock Grid.Column="2" Classes="mono tertiary" FontSize="9.5" HorizontalAlignment="Right" Text="{l:Tr AxisNow}" />
                </Grid>
              </StackPanel>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
      <TextBlock Classes="caption" Text="{l:Tr ChartLegend}" />

      <!-- Spikes -->
      <StackPanel Spacing="10">
        <Grid ColumnDefinitions="*,Auto">
          <TextBlock Classes="label" FontSize="10" VerticalAlignment="Center" Text="{l:Tr SpikesTitle, Upper=True}" />
          <Button Grid.Column="1" Classes="small" Content="{l:Tr AskSpikes, Upper=True}" Command="{Binding AskAboutSpikesCommand}" IsVisible="{Binding CanAskAboutSpikes}" />
        </Grid>
        <TextBlock Classes="secondary" FontSize="13" Text="{l:Tr SpikesNone}" IsVisible="{Binding NoSpikes}" />
        <ItemsControl ItemsSource="{Binding Spikes}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:SpikeRowViewModel">
              <Border Classes="rule" Padding="10,9">
                <Grid ColumnDefinitions="150,70,*,70,Auto" ColumnSpacing="14">
                  <TextBlock Classes="mono" FontSize="12" VerticalAlignment="Center" Text="{Binding When}" />
                  <TextBlock Grid.Column="1" Classes="mono secondary" FontSize="12" VerticalAlignment="Center" Text="{Binding DurationText}" />
                  <StackPanel Grid.Column="2" Spacing="2">
                    <TextBlock Text="{Binding MetricText}" />
                    <TextBlock Classes="caption" TextTrimming="CharacterEllipsis" Text="{Binding AppText}" IsVisible="{Binding HasApp}" />
                  </StackPanel>
                  <TextBlock Grid.Column="3" Classes="number" FontSize="18" Foreground="{DynamicResource Brush.Accent}" TextAlignment="Right" VerticalAlignment="Center" Text="{Binding PeakText}" />
                  <TextBlock Grid.Column="4" Classes="mono secondary" FontSize="11.5" VerticalAlignment="Center" Text="{Binding UsualText}" />
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>

      <!-- System log -->
      <StackPanel Spacing="10" IsVisible="{Binding HasLogReader}">
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
          <StackPanel Spacing="4">
            <TextBlock Classes="label" FontSize="10" Text="{l:Tr LogsTitle, Upper=True}" />
            <TextBlock Classes="secondary" FontSize="13" TextWrapping="Wrap" Text="{Binding LogsSub}" />
          </StackPanel>
          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Bottom">
            <Button Classes="small" Content="{l:Tr ReadLogs, Upper=True}" Command="{Binding ReadLogsCommand}" />
            <Button Classes="primary" MinHeight="26" Padding="10,0" FontSize="9.5" LetterSpacing="0.6" Content="{l:Tr AskLogs, Upper=True}"
                    Command="{Binding AskAboutLogsCommand}" IsVisible="{Binding CanAskAboutLogs}" />
          </StackPanel>
        </Grid>
        <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding HasLogStatus}">
          <TextBlock Classes="blink" Foreground="{DynamicResource Brush.Accent}" FontSize="11" Text="●" IsVisible="{Binding IsReadingLogs}" />
          <TextBlock FontSize="13" Text="{Binding LogStatus}" />
        </StackPanel>
        <ItemsControl ItemsSource="{Binding LogRows}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:LogRowViewModel">
              <Border Classes="rule" Padding="10,9">
                <Grid ColumnDefinitions="78,*" ColumnSpacing="14">
                  <Border Classes="badge" VerticalAlignment="Top" HorizontalAlignment="Left" Classes.accent="{Binding IsSerious}">
                    <TextBlock Text="{Binding SeverityText, Converter={x:Static controls:TextCase.Upper}}" />
                  </Border>
                  <StackPanel Grid.Column="1" Spacing="3">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                      <TextBlock Classes="mono" FontSize="12" TextTrimming="CharacterEllipsis" Text="{Binding SourceText}" />
                      <TextBlock Grid.Column="1" Classes="mono secondary" FontSize="11.5" Text="{Binding TimesText}" />
                    </Grid>
                    <TextBlock Classes="secondary" FontSize="12.5" LineHeight="18" TextWrapping="Wrap" Text="{Binding Message}" />
                  </StackPanel>
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <TextBlock Classes="caption" TextWrapping="Wrap" Text="{l:Tr LogsPrivacy}" IsVisible="{Binding CanAskAboutLogs}" />
      </StackPanel>
    </StackPanel>
  </ScrollViewer>
</UserControl>
